# PostgreSQL 16 Database URLs
DATABASE_URL=postgresql+psycopg2://postgres:inventory@localhost:5432/inventory
TEST_DATABASE_URL=postgresql+psycopg2://postgres:inventory@localhost:5432/inventory_test

# JWT Authentication
JWT_SECRET_KEY=change-this-in-production-to-a-secure-random-32-byte-hex-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

